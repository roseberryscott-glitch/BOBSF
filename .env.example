# Copy to .env.local for local development, and add the same values in Vercel.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only. Never share or commit this.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Event times are entered and shown in this time zone.
NEXT_PUBLIC_SITE_TIMEZONE=America/New_York

# Postmark (email). Without a token, emails are printed to the server log.
POSTMARK_SERVER_TOKEN=
POSTMARK_BROADCAST_STREAM=broadcast
EMAIL_FROM="BOBSF <no-reply@yourdomain.org>"
